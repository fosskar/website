---
import "@fontsource-variable/inter";
import "@fontsource/commit-mono/500.css";
import Search from "../components/Search.astro";
import { fosskar, storePath } from "../lib/site-data";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  /** full-width main column (home, cv); articles keep the reading width */
  wide?: boolean;
  noindex?: boolean;
}
const {
  title,
  description,
  lang = "en",
  wide = false,
  noindex = false,
} = Astro.props;
// subpages start with their path, each segment a link; the home page has none
const segments = Astro.url.pathname.split("/").filter(Boolean);
const esc = (t: string) => t.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
// built as a string so template whitespace can't split the path
const crumbs = [
  `<a href="/" translate="no">~/fosskar</a>`,
  ...segments.map((seg, i) =>
    i === segments.length - 1
      ? `/<span aria-current="page">${esc(seg)}</span>`
      : `/<a href="/${segments.slice(0, i + 1).map(esc).join("/")}/">${esc(seg)}</a>`,
  ),
].join("");
const settings = fosskar.website.settings;

---

<!doctype html>
<html
  lang={lang}
  data-theme={settings.colorScheme}
  data-font={settings.font}
  style={`--font-size: ${settings.fontSize}px`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="alternate" type="application/rss+xml" title="fosskar blog" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <!-- website.settings from fosskar.nix; values changed on the home page win -->
    <script is:inline define:vars={{ settings }}>
      const root = document.documentElement;
      window.applySettings = (s) => {
        root.dataset.theme = s.colorScheme;
        root.dataset.font = s.font;
        root.style.setProperty("--font-size", `${s.fontSize}px`);
      };
      // localStorage is outside the build: older builds stored other keys,
      // and the value may not parse
      let saved = {};
      try {
        saved = JSON.parse(localStorage.getItem("settings") ?? "{}");
      } catch {
        localStorage.removeItem("settings");
      }
      const known = Object.keys(settings).filter((k) => k in saved);
      applySettings({ ...settings, ...Object.fromEntries(known.map((k) => [k, saved[k]])) });
    </script>
  </head>
  <body>
    <a class="skip" href="#content">skip to content</a>
    {
      segments.length > 0 && (
        <header class="crumbs">
          <div class="bar">
            <nav aria-label="breadcrumb" set:html={crumbs} />
            <button class="search-btn" type="button" data-search-open>
              search <kbd>⌘K</kbd>
            </button>
          </div>
        </header>
      )
    }
    <main id="content" class:list={{ wide }}>
      <slot />
    </main>
    <footer>
      <div class="bar">
        <span>
          © {new Date().getFullYear()} {fosskar.name}
        </span>
        {
          storePath && (
            <span
              class="built"
              set:html={`built as <span class="dim">/nix/store/</span>${esc(storePath.replace("/nix/store/", ""))}`}
            />
          )
        }
      </div>
    </footer>
    <dialog id="search-dialog" aria-label="search">
      <Search />
    </dialog>
    <script>
      // hover "#" anchors on article body headings
      document
        .querySelectorAll<HTMLElement>("article :is(h2, h3, h4)[id]")
        .forEach((h) => {
          const a = document.createElement("a");
          a.href = `#${h.id}`;
          a.className = "heading-anchor";
          a.textContent = "#";
          a.setAttribute("aria-hidden", "true");
          a.tabIndex = -1;
          h.appendChild(a);
        });
    </script>
  </body>
</html>

<style is:global>
  /* pi-jade from nixfiles modules/flake-parts/themes.nix: the pi logo
     colours with a jade primary. on the home page they tell the kinds of
     value apart: site paths coral, external blue, settings yellow */
  :root {
    --bg: #1b1b1b;
    --bg-alt: #232323;
    --border: #2e2e2e;
    --text: #cfcfcf;
    --strong: #f0f0f0;
    --muted: #9d9d9d;
    --dim: #8a8a8a;
    --accent: #6fc29b;
    --accent-bright: #8fd3b3;
    --string: #6fc29b;
    --path: #f09082;
    --ext: #4d9abf;
    --set: #f1be58;
    --red: #e65b53;
    --mono: "Commit Mono", ui-monospace, monospace;
    color-scheme: dark;
    font-family: "Inter Variable", system-ui, sans-serif;
  }
  :root[data-theme="light"] {
    --bg: #fafafa;
    --bg-alt: #f1f1f1;
    --border: #e0e0e0;
    --text: #262626;
    --strong: #0e0e0e;
    --muted: #616161;
    --dim: #6b6b6b;
    --accent: #1f7855;
    --accent-bright: #165c41;
    --string: #1f7855;
    --path: #a85044;
    --ext: #207296;
    --set: #8a6403;
    --red: #c4392f;
    color-scheme: light;
  }
  :root[data-font="commit mono"] {
    font-family: var(--mono);
  }
  html {
    scroll-padding-top: 2rem;
  }
  /* screen only: the cv sets its own root size for print */
  @media screen {
    html {
      font-size: var(--font-size);
    }
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 60;
    padding: 0.5rem 1rem;
    background: var(--bg-alt);
    border: 1px solid var(--border);
  }
  .skip:focus-visible {
    top: 0.5rem;
  }
  * {
    box-sizing: border-box;
  }
  /* the hidden attribute must win over component display rules */
  [hidden] {
    display: none !important;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-size: 1.0625rem;
    line-height: 1.75;
    -webkit-font-smoothing: antialiased;
    display: flex;
    min-height: 100vh;
    flex-direction: column;
  }

  .bar {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  /* ---- path line on subpages ---- */
  .crumbs {
    font: 0.9rem var(--mono);
  }
  .crumbs .bar {
    padding-block: 1.6rem 0;
  }
  .crumbs nav {
    color: var(--dim);
    overflow-wrap: anywhere;
  }
  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .crumbs [aria-current] {
    color: var(--strong);
  }
  .search-btn {
    flex: none;
    font: inherit;
    font-size: 0.82rem;
    color: var(--dim);
    background: none;
    border: 0;
    cursor: pointer;
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0;
  }
  .search-btn:hover {
    color: var(--strong);
  }
  kbd {
    font: 500 0.72rem var(--mono);
    padding: 0.05rem 0.35rem;
    border-radius: 4px;
    border: 1px solid var(--border);
    color: var(--muted);
  }
  @media (max-width: 48rem) {
    .bar {
      padding: 0 1.25rem;
    }
  }

  /* ---- search dialog ---- */
  #search-dialog {
    border: 0;
    padding: 0;
    background: transparent;
    width: min(40rem, 92vw);
    margin-top: 15vh;
    overflow: visible;
  }
  #search-dialog::backdrop {
    background: color-mix(in srgb, var(--bg) 75%, transparent);
  }

  main {
    max-width: 60rem;
    margin: 0 auto;
    padding: 3.5rem 2rem 5rem;
    width: 100%;
    flex: 1;
    overflow-wrap: break-word;
  }
  main.wide {
    max-width: 72rem;
  }
  @media (max-width: 48rem) {
    main {
      padding-inline: 1.25rem;
    }
  }

  /* ---- footer: one line ---- */
  footer {
    color: var(--dim);
    font: 0.78rem/1.7 var(--mono);
  }
  footer .bar {
    padding-block: 2rem;
    gap: 1rem 2rem;
    flex-wrap: wrap;
  }
  footer a {
    color: var(--muted);
  }
  footer .built {
    overflow-wrap: anywhere;
  }
  footer .dim {
    color: var(--dim);
  }

  /* ---- typography ---- */
  h1,
  h2,
  h3 {
    line-height: 1.25;
    letter-spacing: -0.015em;
    text-wrap: balance;
    color: var(--strong);
  }
  h1 {
    font-size: 2.4rem;
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
  }
  h2 {
    font-size: 1.4rem;
    margin: 2.75rem 0 0.75rem;
  }
  h3 {
    font-size: 1.1rem;
    margin: 1.5rem 0 0.5rem;
  }
  p {
    margin: 1.1rem 0;
  }
  li + li {
    margin-top: 0.3rem;
  }
  a {
    color: var(--accent);
  }
  a:hover {
    color: var(--accent-bright);
  }
  code {
    background: var(--bg-alt);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 0.9em;
  }
  pre {
    background: var(--bg-alt) !important;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
    overflow-x: auto;
  }
  /* shiki's light theme is made for white; the tinted block drops its
     comments below 4.5:1 */
  :root[data-theme="light"] .astro-code {
    background: var(--bg) !important;
  }
  pre code {
    background: none;
    padding: 0;
  }
  /* shiki dual themes: tokens carry inline light colors plus --shiki-dark
     variables; switch to them when the site renders dark */
  :root:not([data-theme="light"]) :is(.astro-code, .astro-code span) {
    color: var(--shiki-dark) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
  }
  blockquote {
    border-left: 2px solid var(--accent);
    margin-left: 0;
    padding: 0.25rem 0 0.25rem 1rem;
    color: var(--muted);
  }
  hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }
  table {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  th,
  td {
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  th {
    background: var(--bg-alt);
  }
  img {
    max-width: 100%;
    border-radius: 6px;
  }

  /* ---- shared components: flat surfaces, no blur or glow ---- */
  .surface,
  .card {
    background: var(--bg-alt);
    border: 1px solid var(--border);
  }
  .card {
    display: block;
    border-radius: 8px;
    padding: 1.1rem 1.35rem;
    transition: border-color 0.15s ease;
  }
  a.card {
    color: inherit;
    text-decoration: none;
  }
  a.card:hover {
    border-color: var(--dim);
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .muted {
    color: var(--muted);
  }
  .chip {
    display: inline-block;
    font: 0.75rem/1.4 var(--mono);
    padding: 0.05rem 0.45rem;
    border-radius: 4px;
    border: 1px solid var(--border);
    color: var(--muted);
    white-space: nowrap;
  }
  .meta {
    color: var(--muted);
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 0.25rem 0;
  }

  /* ---- heading anchors ---- */
  .heading-anchor {
    margin-left: 0.5rem;
    color: var(--accent);
    text-decoration: none;
    opacity: 0;
  }
  :is(h2, h3, h4):hover .heading-anchor {
    opacity: 1;
  }

  @media print {
    /* paper is light whatever the screen theme is */
    :root,
    :root[data-theme] {
      color-scheme: light;
      --bg: #fff;
      --bg-alt: #fff;
      --border: #e0e0e0;
      --text: #262626;
      --strong: #0e0e0e;
      --muted: #616161;
      --dim: #6b6b6b;
      --accent: #1f7855;
      --accent-bright: #165c41;
      --string: #1f7855;
      --path: #a85044;
      --ext: #207296;
      --set: #8a6403;
      --red: #c4392f;
    }
    .crumbs,
    footer,
    #search-dialog {
      display: none !important;
    }
    body {
      display: block;
      background: none;
    }
    main {
      padding: 0;
      max-width: none;
    }
  }
</style>
