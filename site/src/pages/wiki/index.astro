---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import {
  SECTIONS,
  groupsOf,
  noteHref,
  orderedSections,
  sectionOf,
} from "../../lib/notes";

const all = await getCollection("wiki");
const sections = orderedSections(all.map((e) => sectionOf(e.id))).map(
  (dir) => ({ dir, groups: groupsOf(dir, all) }),
);
const count = (groups: [string, unknown[]][]) =>
  groups.reduce((n, [, g]) => n + g.length, 0);
---

<Layout
  title="wiki — fosskar"
  description="practical notes and troubleshooting writeups on nixos, kubernetes and homelab"
  wide
>
  <div class="wiki">
    <nav class="contents" aria-label="wiki sections">
      <span class="contents-title">contents</span>
      <ul>
        {
          sections.map(({ dir, groups }) => (
            <li>
              <a href={`#${dir}`}>
                {dir}
                <span>{count(groups)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <header class="intro">
        <h1>wiki</h1>
        <p>
          notes on problems i ran into, like a machine that needed fixing or a
          setup annoying enough to write down. each note explains what worked
          and why, including the tradeoffs.
        </p>
      </header>

      <div class="sections">
        {
          sections.map(({ dir, groups }) => (
            <section class="card" id={dir}>
              <h2>{dir}</h2>
              {SECTIONS[dir] && <p class="desc">{SECTIONS[dir]}</p>}
              {groups.map(([sub, notes]) => (
                <>
                  {sub && <h3>{sub}</h3>}
                  <ul>
                    {notes.map((note) => (
                      <li>
                        <a href={noteHref(note.id)}>{note.data.title}</a>
                        {note.data.type !== "note" && (
                          <span class="type">{note.data.type}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </>
              ))}
            </section>
          ))
        }
      </div>
    </div>
  </div>
</Layout>

<style>
  .wiki {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 4rem;
    padding-top: 3.5rem;
  }
  .contents {
    position: sticky;
    top: 6.5rem;
    align-self: start;
  }
  .contents-title {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--dim);
  }
  .contents ul {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    border-left: 1px solid var(--border);
  }
  .contents a {
    display: flex;
    justify-content: space-between;
    padding: 0.35rem 0 0.35rem 1rem;
    margin-left: -1px;
    border-left: 1px solid transparent;
    color: var(--text);
    text-decoration: none;
  }
  .contents a:hover {
    color: var(--accent);
    border-left-color: var(--accent);
  }
  .contents a span {
    color: var(--dim);
    font-family: var(--mono);
    font-size: 0.8rem;
  }
  .intro {
    max-width: 44rem;
    margin-bottom: 2.5rem;
  }
  .intro h1 {
    font-size: 3rem;
    letter-spacing: -0.045em;
  }
  .intro p {
    color: var(--muted);
    font-size: 1.1rem;
  }
  .sections {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
  }
  .sections .card {
    padding: 1.75rem;
    scroll-margin-top: 6rem;
  }
  .sections h2 {
    margin: 0 0 0.25rem;
    font-size: 1.4rem;
  }
  .desc {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .sections h3 {
    margin: 1rem 0 0.25rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dim);
  }
  .sections ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sections li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.45rem 0;
    border-top: 1px solid color-mix(in srgb, var(--strong) 7%, transparent);
  }
  .sections li a {
    color: var(--strong);
    text-decoration: none;
  }
  .sections li a:hover {
    color: var(--accent);
  }
  .type {
    flex: none;
    font-size: 0.72rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.05rem 0.4rem;
  }
  @media (max-width: 64rem) {
    .sections {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 48rem) {
    .wiki {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-top: 2rem;
    }
    .contents {
      position: static;
    }
  }
</style>
