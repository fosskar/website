---
import Layout from "../../layouts/Layout.astro";
import ArticleHead from "../../components/ArticleHead.astro";
import WikiTree from "../../components/WikiTree.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import {
  assertUniqueSlugs,
  sectionHref,
  sectionOf,
  slugOf,
} from "../../lib/notes";

export async function getStaticPaths() {
  const entries = await getCollection("wiki");
  assertUniqueSlugs(entries.map((e) => e.id));
  return entries.map((entry) => ({
    params: { slug: slugOf(entry.id) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"wiki">;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const section = sectionOf(entry.id);
const all = await getCollection("wiki");
const toc = (entry.data.enableToc ?? true)
  ? headings.filter((h) => h.depth >= 2 && h.depth <= 3)
  : [];
---

<Layout
  title={`${entry.data.title} — fosskar`}
  description={entry.data.description}
  wide
>
  <div class="note">
    <nav class="wiki-sidebar" aria-label="wiki notes">
      <WikiTree notes={all} current={entry.id} />
    </nav>
    <div class="main-col">
      <details class="wiki-browse">
        <summary>browse wiki</summary>
        <WikiTree notes={all} current={entry.id} />
      </details>
      <article>
        <ArticleHead
          title={entry.data.title}
          description={entry.data.description}
          date={entry.data.date}
          datePrefix="last verified"
        >
          <nav slot="topline" aria-label="section">
            <a href="/wiki/">wiki</a> / <a href={sectionHref(section)}>{section}</a>
          </nav>
          <Fragment slot="chips">
            {entry.data.type !== "note" && <span class="chip">{entry.data.type}</span>}
          </Fragment>
        </ArticleHead>
        <Content />
      </article>
    </div>
    {
      toc.length > 1 && (
        <nav class="toc" aria-label="table of contents">
          <span class="toc-title">on this page</span>
          <ul>
            {toc.map((h) => (
              <li class={`depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</Layout>

<style>
  /* note tree | article | on this page; side columns drop out as space shrinks */
  .note {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr) 13rem;
    gap: 3.5rem;
    padding-top: 3rem;
  }
  .wiki-sidebar,
  .toc {
    position: sticky;
    top: 6.5rem;
    align-self: start;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .main-col {
    min-width: 0;
  }
  article {
    max-width: 48rem;
  }
  .wiki-browse {
    display: none;
    margin-bottom: 1.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 0.9rem;
  }
  .wiki-browse > summary {
    cursor: pointer;
    color: var(--muted);
  }
  .wiki-browse[open] > summary {
    margin-bottom: 0.5rem;
  }
  .toc-title {
    color: var(--dim);
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    border-left: 1px solid var(--border);
  }
  .toc li {
    padding: 0.2rem 0 0.2rem 0.85rem;
  }
  .toc li.depth-3 {
    padding-left: 1.75rem;
  }
  .toc a {
    color: var(--muted);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--accent);
  }
  @media (max-width: 80rem) {
    .note {
      grid-template-columns: 14rem minmax(0, 1fr);
    }
    .toc {
      display: none;
    }
  }
  @media (max-width: 60rem) {
    .note {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 2rem;
    }
    .wiki-sidebar {
      display: none;
    }
    .wiki-browse {
      display: block;
    }
  }
</style>
