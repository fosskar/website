---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const skills = [
  ["platform", "kubernetes, talos, cluster api, cilium, argocd, harbor"],
  ["systems", "nixos, clan-core, proxmox, zfs, openwrt"],
  ["code", "nix, go, rust, bash"],
  ["languages", "german (native), english (fluent)"],
];
---

<Layout
  title="cv — simon (fosskar)"
  description="cv of simon (fosskar), devops engineer and sre"
  wide
>
  <article class="sheet">
    <header class="top">
      <div>
        <h1>Simon</h1>
        <p class="role">devops engineer &amp; sre · nix, kubernetes, gitops</p>
        <p class="place">hamburg, germany</p>
      </div>
      <ul>
        <li><a href="mailto:simon@nx3.eu">simon@nx3.eu</a></li>
        <li><a href="https://github.com/fosskar">github.com/fosskar</a></li>
        <li><a href="https://matrix.to/#/@fosskar:fosskar.de">@fosskar:fosskar.de</a></li>
        <li><a href="https://radicle.fosskar.eu">radicle.fosskar.eu</a></li>
        <li><a href="https://bliki.fosskar.eu">bliki.fosskar.eu</a></li>
      </ul>
    </header>

    <section class="row">
      <h2>profile</h2>
      <div>
        <p>
          devops engineer since 2023, after years of running linux as a hobby.
          i build kubernetes platforms with gitops at work and declare
          everything else in nix. i dislike doing the same thing twice by
          hand, and i fix annoyances properly instead of working around them.
        </p>
      </div>
    </section>

    <section class="row">
      <h2>experience</h2>
      <div>
        <div class="item">
          <div class="head"><h3>devops engineer / sre</h3><span class="when">2023 — now</span></div>
          <p>kubernetes platform, gitops with argocd, cluster api on proxmox, cilium networking, harbor registry.</p>
        </div>
        <div class="item">
          <div class="head"><h3>devops bootcamp</h3><span class="when">2022</span></div>
          <p>career change from hobbyist linux admin into devops.</p>
        </div>
      </div>
    </section>

    <section class="row">
      <h2>open source</h2>
      <div>
        {
          projects.map((p) => (
            <div class="item">
              <div class="head">
                <h3>
                  {p.data.repo ? <a href={p.data.repo}>{p.data.title}</a> : p.data.title}
                </h3>
                <span class="when">{p.data.tags.slice(0, 2).join(" · ")}</span>
              </div>
              <p>{p.data.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="row">
      <h2>skills</h2>
      <dl class="skills">
        {
          skills.map(([k, v]) => (
            <>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </>
          ))
        }
      </dl>
    </section>

    <section class="row">
      <h2>writing</h2>
      <div>
        <p>
          a <a href="/blog/">blog</a> and a <a href="/wiki/">wiki</a> of
          problems i solved: nixos, kubernetes, homelab.
        </p>
      </div>
    </section>
  </article>
  <div class="tools">
    <span>this page is the cv</span>
    <button type="button" id="print">print / save as pdf</button>
  </div>
</Layout>

<script>
  document.getElementById("print")!.addEventListener("click", () => print());
</script>

<style>
  /* light paper sheet in both colour schemes; prints as the cv */
  .sheet {
    --paper: #fdfcf9;
    --ink: #1a1a1a;
    --soft: #5e5e5e;
    --rule: #e6e3dc;
    --ink-accent: #0b6e5b;
    color-scheme: light;
    max-width: 60rem;
    margin: 3rem auto 0;
    background: var(--paper);
    color: var(--ink);
    padding: 4.5rem;
    border-radius: 6px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.08),
      0 20px 60px rgba(0, 0, 0, 0.25);
  }
  .sheet a {
    color: var(--ink);
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
  }
  .sheet a:hover {
    color: var(--ink-accent);
  }
  .sheet :is(h1, h2, h3) {
    color: var(--ink);
  }
  .top {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: end;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--ink);
  }
  .top h1 {
    font-family: Georgia, "Iowan Old Style", serif;
    font-weight: 400;
    font-size: 3rem;
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1;
  }
  .role {
    margin: 0.6rem 0 0;
    color: var(--soft);
    font-size: 1.05rem;
  }
  .place {
    margin: 0.25rem 0 0;
    color: var(--soft);
  }
  .top ul {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: right;
    font-size: 0.9rem;
    line-height: 1.8;
  }
  .row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 2rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .row:last-child {
    border: 0;
  }
  .row > h2 {
    margin: 0;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-accent);
    font-weight: 600;
    padding-top: 0.25rem;
  }
  .row p {
    margin: 0;
  }
  .item + .item {
    margin-top: 1.1rem;
  }
  .head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .item h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }
  .item h3 a {
    text-decoration: none;
  }
  .when {
    color: var(--soft);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .item p {
    margin: 0.2rem 0 0;
    color: var(--soft);
    font-size: 0.95rem;
  }
  .skills {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.35rem 1rem;
    margin: 0;
    font-size: 0.95rem;
  }
  .skills dt {
    color: var(--soft);
  }
  .skills dd {
    margin: 0;
  }
  .tools {
    max-width: 60rem;
    margin: 1rem auto 0;
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--muted);
    padding: 0 0.25rem;
  }
  .tools button {
    font: inherit;
    color: var(--text);
    background: none;
    border: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    padding: 0;
  }
  @media (max-width: 44rem) {
    .sheet {
      padding: 2rem 1.25rem;
      margin-top: 1.5rem;
    }
    .top,
    .row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .top ul {
      text-align: left;
    }
  }
  @media print {
    .sheet {
      box-shadow: none;
      margin: 0;
      padding: 0;
      max-width: none;
    }
    .tools {
      display: none;
    }
  }
</style>
