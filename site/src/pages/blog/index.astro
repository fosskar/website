---
import Layout from "../../layouts/Layout.astro";
import EntryCard from "../../components/EntryCard.astro";
import { getCollection } from "astro:content";
import { published, postHref } from "../../lib/posts";

const posts = published(await getCollection("blog"));
---

<Layout title="blog — fosskar" description="posts by fosskar">
  <header class="head">
    <h1>blog</h1>
    <a class="rss" href="/rss.xml">rss</a>
  </header>
  {posts.length === 0 && <p class="muted">nothing here yet.</p>}
  <div class="stack">
    {
      posts.map((post) => (
        <EntryCard
          href={postHref(post.id)}
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
        />
      ))
    }
  </div>
</Layout>

<style>
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .rss {
    font: 0.85rem var(--mono);
  }
  .stack {
    margin-top: 1.5rem;
  }
</style>
