---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { published } from "../lib/posts";
import { linkFor, tokenize, typeOf } from "../lib/fosskar";
import { fosskar, storePath } from "../lib/site-data";

// the page shows the file the site's data is evaluated from
const source = readFileSync(resolve(process.cwd(), "../fosskar.nix"), "utf8").trimEnd();
const lines = tokenize(source);

const posts = published(await getCollection("blog"));
const notes = (await getCollection("wiki")).sort(
  (a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0),
);
const day = (d?: Date) => d?.toISOString().slice(0, 10) ?? "";

// hover text per top-level attribute, in both page languages
const hovers: Record<string, { en: string; de: string }> = {
  lang: {
    en: "the language of this page. click the value to switch between en and de.",
    de: "die sprache dieser seite. klick auf den wert, um zwischen en und de zu wechseln.",
  },
  colorScheme: {
    en: "dark or light. click the value to switch; the choice is remembered.",
    de: "dunkel oder hell. klick auf den wert zum umschalten; die wahl wird gespeichert.",
  },
  name: { en: "the person behind fosskar.", de: "die person hinter fosskar." },
  role: {
    en: "devops engineer and sre since 2023, in a team of four.",
    de: "devops engineer und sre seit 2023, in einem team aus vier leuten.",
  },
  location: { en: "hamburg, germany.", de: "hamburg." },
  likes: {
    en: "what i spend my free time on. local llms means llama.cpp and vllm in my homelab, with regular benchmarks.",
    de: "womit ich meine freizeit verbringe. lokale llms heißt llama.cpp und vllm im homelab, mit regelmäßigen benchmarks.",
  },
  writing: {
    en: `blog: ${posts.length} post${posts.length === 1 ? "" : "s"}, newest ${day(posts[0]?.data.date)}. wiki: ${notes.length} notes, newest ${day(notes[0]?.data.date)}.`,
    de: `blog: ${posts.length} ${posts.length === 1 ? "beitrag" : "beiträge"}, neuester vom ${day(posts[0]?.data.date)}. wiki: ${notes.length} notizen, neueste vom ${day(notes[0]?.data.date)}.`,
  },
  work: {
    en: "my cv in english and german, and my code.",
    de: "mein lebenslauf auf englisch und deutsch, und mein code.",
  },
  contact: {
    en: "mail or matrix, whichever you prefer.",
    de: "mail oder matrix, wie du magst.",
  },
};
const types: Record<string, string> = Object.fromEntries(
  Object.entries(fosskar).map(([k, v]) => [k, typeOf(v)]),
);

// german replacements for the values and comment that differ
const german: Record<string, string> = {
  "# kubernetes at work, nixos everywhere else": "# beruflich kubernetes, privat überall nixos",
  '"self-hosting"': '"self-hosting"',
  '"local llms"': '"lokale llms"',
  '"fixing things properly"': '"dinge richtig reparieren"',
};

const unquote = (s: string) => s.slice(1, -1);
const esc = (s: string) =>
  s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);

// built as a string: a template inside <pre> would leak its own indentation
const html = lines
  .map((tokens) =>
    tokens
      .map((t) => {
        const text = esc(t.text);
        if (t.kind === "comment")
          return `<span class="c" data-en="${text}" data-de="${esc(german[t.text] ?? t.text)}">${text}</span>`;
        if (t.kind === "attr") {
          const h = t.path && !t.path.includes(".") ? hovers[t.path] : undefined;
          if (!h) return `<span class="k">${text}</span>`;
          return `<span class="k hover" tabindex="0">${text}<span class="tip" role="tooltip"><span class="t">${t.path}</span> : ${types[t.path!]}<span class="en">${esc(h.en)}</span><span class="de">${esc(h.de)}</span></span></span>`;
        }
        if (t.kind === "string") {
          if (t.path === "lang" || t.path === "colorScheme")
            return `<button class="opt" type="button" data-opt="${t.path}">${text}</button>`;
          const href = linkFor(unquote(t.text));
          if (href)
            return `<a class="s" href="${esc(href)}"${t.path === "work.cv" ? ' data-href="cv"' : ""}>${text}</a>`;
          return `<span class="s" data-en="${text}" data-de="${esc(german[t.text] ?? t.text)}">${text}</span>`;
        }
        if (t.kind === "punct") return `<span class="p">${text}</span>`;
        return text;
      })
      .join(""),
  )
  .join("\n");
const outPath = storePath ?? `/nix/store/…-website-0.1.0`;
const sections = ["about", "blog", "cv", "wiki"];
---

<Layout
  title={`${fosskar.name} · fosskar`}
  description={`${fosskar.name} (fosskar): ${fosskar.role} in ${fosskar.location}. nix, nixos, kubernetes and gitops.`}
  wide
>
  <div class="home">
    <pre class="nix" id="nix"><code set:html={html} /></pre>

    <div class="term" id="term">
      <div class="cmd"><span class="prompt">$</span> <span class="typed">nix build github:fosskar/website --print-out-paths</span></div>
      <div class="out path">{outPath}</div>
      <div class="cmd"><span class="prompt">$</span> <span class="typed">ls -d result/*/</span></div>
      <ul class="ls" aria-label="sections">
        {sections.map((s) => <li><a href={`/${s}/`} data-href={s}><span class="dim">result/</span>{s}/</a></li>)}
      </ul>
      <div class="cmd"><span class="prompt">$</span> <span class="cursor"></span></div>
    </div>
  </div>
</Layout>

<script>
  const root = document.documentElement;
  const nix = document.getElementById("nix")!;

  // lang: swap the shown values and point cv/about at the german pages
  function setLang(lang: string) {
    nix.dataset.lang = lang;
    nix.querySelectorAll<HTMLElement>("[data-en]").forEach((e) => {
      e.textContent = e.dataset[lang as "en" | "de"]!;
    });
    document.querySelectorAll<HTMLAnchorElement>("[data-href]").forEach((a) => {
      const s = a.dataset.href!;
      if (s === "cv" || s === "about") a.href = lang === "de" ? `/${s}/de/` : `/${s}/`;
    });
    nix.querySelector<HTMLElement>('[data-opt="lang"]')!.textContent = `"${lang}"`;
  }
  function setScheme(scheme: string) {
    root.dataset.theme = scheme;
    nix.querySelector<HTMLElement>('[data-opt="colorScheme"]')!.textContent = `"${scheme}"`;
  }
  setLang(localStorage.getItem("lang") ?? nix.querySelector<HTMLElement>('[data-opt="lang"]')!.textContent!.slice(1, -1));
  setScheme(root.dataset.theme!);
  nix.querySelectorAll<HTMLButtonElement>(".opt").forEach((b) =>
    b.addEventListener("click", () => {
      if (b.dataset.opt === "lang") {
        const next = nix.dataset.lang === "en" ? "de" : "en";
        localStorage.setItem("lang", next);
        setLang(next);
      } else {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        localStorage.setItem("colorScheme", next);
        setScheme(next);
      }
    }),
  );

  // the build plays once per session; the finished state is in the html
  const term = document.getElementById("term")!;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduced && !sessionStorage.getItem("built")) {
    sessionStorage.setItem("built", "1");
    const steps = [...term.children] as HTMLElement[];
    const typed = steps.map((s) => s.querySelector<HTMLElement>(".typed"));
    const texts = typed.map((t) => t?.textContent ?? "");
    steps.forEach((s) => (s.hidden = true));
    let skip = false;
    const stop = () => (skip = true);
    addEventListener("keydown", stop, { once: true });
    addEventListener("pointerdown", stop, { once: true });
    const wait = (ms: number) => new Promise((r) => setTimeout(r, skip ? 0 : ms));
    (async () => {
      await wait(500);
      for (const [i, s] of steps.entries()) {
        s.hidden = false;
        const t = typed[i];
        if (t) {
          t.textContent = "";
          for (const ch of texts[i]!) {
            t.textContent += ch;
            await wait(28 + Math.random() * 30);
          }
          await wait(260);
        } else {
          await wait(s.classList.contains("path") ? 700 : 150);
        }
      }
    })();
  }

  // arrow keys move through the listing, enter opens
  const links = [...term.querySelectorAll<HTMLAnchorElement>(".ls a")];
  let sel = -1;
  addEventListener("keydown", (e) => {
    if ((e.target as HTMLElement).closest("input, textarea, dialog")) return;
    const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
    if (!step) return;
    e.preventDefault();
    sel = (sel + step + links.length) % links.length;
    links[sel]!.focus();
  });
</script>

<style is:global>
  /* global: the expression's html is built as a string, which scoped styles
     cannot reach; every selector stays under .home */
  .home {
    max-width: 46rem;
    margin: 1rem auto 0;
    font: 1rem/1.85 var(--mono);
    color: var(--muted);
  }
  .home pre.nix {
    margin: 0;
    padding: 0;
    background: none !important;
    border: 0;
    overflow: visible;
    white-space: pre-wrap;
    font: inherit;
  }
  .home .c {
    color: var(--dim);
  }
  .home .k {
    color: var(--strong);
  }
  .home .s,
  .home .opt {
    color: var(--string);
  }
  .home .p {
    color: var(--dim);
  }
  .home a.s {
    text-decoration: none;
    border-bottom: 1px dashed color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .home a.s:hover {
    color: var(--accent-bright);
    border-bottom-style: solid;
  }
  .home .opt {
    font: inherit;
    background: none;
    border: 0;
    border-bottom: 1px dashed var(--string);
    padding: 0;
    cursor: pointer;
  }
  .home .opt:hover {
    color: var(--accent-bright);
  }

  /* hover info, like a language server in an editor */
  .home .hover {
    position: relative;
    cursor: help;
    border-bottom: 1px dotted var(--dim);
  }
  .home .tip {
    display: none;
    position: absolute;
    left: 0;
    top: 1.9em;
    z-index: 5;
    width: max-content;
    max-width: 24rem;
    padding: 0.5rem 0.75rem;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--text);
    white-space: normal;
    cursor: default;
  }
  .home .tip .t {
    color: var(--accent);
  }
  .home .tip :is(.en, .de) {
    display: block;
    margin-top: 0.25rem;
    color: var(--muted);
  }
  .home .nix:not([data-lang="de"]) .tip .de,
  .home .nix[data-lang="de"] .tip .en {
    display: none;
  }
  .home .hover:is(:hover, :focus-visible) .tip {
    display: block;
  }

  /* the build below the expression */
  /* room for all five lines, so the page doesn't grow while the build types */
  .home .term {
    margin-top: 2.25rem;
    min-height: calc(5 * 1.85em);
  }
  .home .prompt {
    color: var(--accent);
  }
  .home .cmd {
    color: var(--strong);
  }
  .home .out.path {
    color: var(--dim);
    overflow-wrap: anywhere;
  }
  .home .ls {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 2rem;
  }
  .home .ls li + li {
    margin: 0;
  }
  .home .ls a {
    color: #5a8ee5;
    text-decoration: none;
    outline: none;
    padding: 0 0.15rem;
    margin: 0 -0.15rem;
    border-radius: 3px;
  }
  .home .ls a:is(:hover, :focus-visible) {
    background: var(--accent);
    color: var(--bg);
  }
  .home .ls a:is(:hover, :focus-visible) .dim {
    color: inherit;
  }
  .home .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    vertical-align: -0.2em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home .cursor {
      animation: none;
    }
  }
</style>
