---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { published } from "../lib/posts";
import { linkFor, tokenize, typeOf } from "../lib/fosskar";
import { fosskar } from "../lib/site-data";

// the page shows the file the site's data is evaluated from
const source = readFileSync(resolve(process.cwd(), "../fosskar.nix"), "utf8").trimEnd();
const lines = tokenize(source);

const posts = published(await getCollection("blog"));
const notes = (await getCollection("wiki")).sort(
  (a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0),
);
const day = (d?: Date) => d?.toISOString().slice(0, 10) ?? "";

// hover text per top-level attribute
const hovers: Record<string, string> = {
  name: "the person behind fosskar.",
  role: "devops engineer and sre since 2023, in a team of four.",
  location: "hamburg, germany.",
  colorScheme: "dark or light. click the value to switch; the choice is remembered.",
  likes:
    "what i spend my free time on. local llms means llama.cpp and vllm in my homelab, with regular benchmarks.",
  writing: `blog: ${posts.length} post${posts.length === 1 ? "" : "s"}, newest ${day(posts[0]?.data.date)}. wiki: ${notes.length} notes, newest ${day(notes[0]?.data.date)}.`,
  work: "what i work on, my cv in english and german (page and pdf), and my code.",
  contact: "mail or matrix, whichever you prefer.",
};
const types: Record<string, string> = Object.fromEntries(
  Object.entries(fosskar).map(([k, v]) => [k, typeOf(v)]),
);

const esc = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);

// built as a string: a template inside <pre> would leak its own indentation
const html = lines
  .map((tokens, i) => {
    const code = tokens
      .map((t) => {
        const text = esc(t.text);
        if (t.kind === "comment") return `<span class="c">${text}</span>`;
        if (t.kind === "attr") {
          const h = t.path && !t.path.includes(".") ? hovers[t.path] : undefined;
          if (!h) return `<span class="k">${text}</span>`;
          return `<span class="k hover" tabindex="0">${text}<span class="tip${i >= lines.length / 2 ? " up" : ""}" role="tooltip"><span class="t">${t.path}</span> : ${types[t.path!]}<span class="d">${esc(h)}</span></span></span>`;
        }
        if (t.kind === "string") {
          if (t.path === "colorScheme")
            return `<button class="opt" type="button" data-opt="colorScheme">${text}</button>`;
          const href = linkFor(t.text.slice(1, -1));
          if (href) return `<a class="s" href="${esc(href)}">${text}</a>`;
          return `<span class="s">${text}</span>`;
        }
        if (t.kind === "punct") return `<span class="p">${text}</span>`;
        return text;
      })
      .join("");
    return code;
  })
  .join("\n");

---

<Layout
  title={`${fosskar.name} · fosskar`}
  description={`${fosskar.name} (fosskar): ${fosskar.role} in ${fosskar.location}. nix, nixos, kubernetes and gitops.`}
  wide
>
  <div class="home">
    <pre class="nix" id="nix"><code set:html={html} /></pre>
  </div>
</Layout>

<script>
  const root = document.documentElement;
  const nix = document.getElementById("nix")!;

  // colorScheme: switch the whole site and remember the choice
  const opt = nix.querySelector<HTMLButtonElement>('[data-opt="colorScheme"]')!;
  const show = () => (opt.textContent = `"${root.dataset.theme}"`);
  show();
  opt.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    localStorage.setItem("colorScheme", next);
    show();
  });

</script>

<style is:global>
  /* global: the expression's html is built as a string, which scoped styles
     cannot reach; every selector stays under .home */
  .home {
    max-width: 50rem;
    margin: 0 auto;
    padding-top: 3rem;
    font: 0.95rem/1.85 var(--mono);
    color: var(--muted);
  }

  .home pre.nix {
    margin: 0;
    padding: 0 0 1rem;
    background: none !important;
    border: 0;
    border-radius: 0;
    overflow-x: auto;
    font: inherit;
  }
  .home .c {
    color: var(--dim);
  }
  .home .k {
    color: var(--strong);
  }
  .home .s,
  .home .opt {
    color: var(--string);
  }
  .home .p {
    color: var(--dim);
  }
  .home a.s {
    text-decoration: none;
    border-bottom: 1px dashed color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .home a.s:hover {
    color: var(--accent-bright);
    border-bottom-style: solid;
  }
  .home .opt {
    font: inherit;
    background: none;
    border: 0;
    border-bottom: 1px dashed var(--string);
    padding: 0;
    cursor: pointer;
  }
  .home .opt:hover {
    color: var(--accent-bright);
  }

  /* hover info, like a language server in an editor */
  .home .hover {
    position: relative;
    cursor: help;
    border-bottom: 1px dotted var(--dim);
  }
  .home .tip {
    display: none;
    position: absolute;
    left: 0;
    top: 1.9em;
    z-index: 5;
    width: max-content;
    max-width: 24rem;
    padding: 0.5rem 0.75rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--text);
    white-space: normal;
    cursor: default;
  }
  /* opens upward in the lower half; the pre scrolls sideways on phones and so clips below */
  .home .tip.up {
    top: auto;
    bottom: 1.9em;
  }
  .home .tip .t {
    color: var(--accent);
  }
  .home .tip .d {
    display: block;
    margin-top: 0.25rem;
    color: var(--muted);
  }
  .home .hover:is(:hover, :focus-visible) .tip {
    display: block;
  }

</style>
