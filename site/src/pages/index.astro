---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { published } from "../lib/posts";
import { linkFor, tokenize, typeOf } from "../lib/fosskar";
import { fosskar, storePath } from "../lib/site-data";

// the page shows the file the site's data is evaluated from
const source = readFileSync(resolve(process.cwd(), "../fosskar.nix"), "utf8").trimEnd();
const lines = tokenize(source);

const posts = published(await getCollection("blog"));
const notes = (await getCollection("wiki")).sort(
  (a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0),
);
const day = (d?: Date) => d?.toISOString().slice(0, 10) ?? "";

// hover text per top-level attribute
const hovers: Record<string, string> = {
  name: "the person behind fosskar.",
  role: "devops engineer and sre since 2023, in a team of four.",
  location: "hamburg, germany.",
  colorScheme: "dark or light. click the value to switch; the choice is remembered.",
  likes:
    "what i spend my free time on. local llms means llama.cpp and vllm in my homelab, with regular benchmarks.",
  writing: `blog: ${posts.length} post${posts.length === 1 ? "" : "s"}, newest ${day(posts[0]?.data.date)}. wiki: ${notes.length} notes, newest ${day(notes[0]?.data.date)}.`,
  work: "my cv in english and german, as a page and as pdf, and my code.",
  contact: "mail or matrix, whichever you prefer.",
};
const types: Record<string, string> = Object.fromEntries(
  Object.entries(fosskar).map(([k, v]) => [k, typeOf(v)]),
);

const esc = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);

// built as a string: a template inside <pre> would leak its own indentation
const html = lines
  .map((tokens, i) => {
    const code = tokens
      .map((t) => {
        const text = esc(t.text);
        if (t.kind === "comment") return `<span class="c">${text}</span>`;
        if (t.kind === "attr") {
          const h = t.path && !t.path.includes(".") ? hovers[t.path] : undefined;
          if (!h) return `<span class="k">${text}</span>`;
          return `<span class="k hover" tabindex="0">${text}<span class="tip" role="tooltip"><span class="t">${t.path}</span> : ${types[t.path!]}<span class="d">${esc(h)}</span></span></span>`;
        }
        if (t.kind === "string") {
          if (t.path === "colorScheme")
            return `<button class="opt" type="button" data-opt="colorScheme">${text}</button>`;
          const href = linkFor(t.text.slice(1, -1));
          if (href) return `<a class="s" href="${esc(href)}">${text}</a>`;
          return `<span class="s">${text}</span>`;
        }
        if (t.kind === "punct") return `<span class="p">${text}</span>`;
        return text;
      })
      .join("");
    return `<span class="ln" aria-hidden="true">${i + 1}</span>${code}`;
  })
  .join("\n");

// the build log replays real astro output; the page count matches this build
const pages = 8 + posts.length + notes.length;
const outPath = storePath ?? "/nix/store/…-website-0.1.0";
const sections = ["about", "blog", "cv", "wiki"];
---

<Layout
  title={`${fosskar.name} · fosskar`}
  description={`${fosskar.name} (fosskar): ${fosskar.role} in ${fosskar.location}. nix, nixos, kubernetes and gitops.`}
  wide
>
  <div class="home">
    <figure class="frame file">
      <figcaption><span class="tab">fosskar.nix</span></figcaption>
      <pre class="nix" id="nix"><code set:html={html} /></pre>
    </figure>

    <figure class="frame term" id="term" title="click to run the build again">
      <figcaption>~/fosskar</figcaption>
      <div class="screen">
        <div class="cmd"><span class="prompt">$</span> <span class="typed">nix build github:fosskar/website -L --print-out-paths</span></div>
        <div class="log">website&gt; [content] Syncing content</div>
        <div class="log">website&gt; [content] Synced content</div>
        <div class="log">website&gt; [build] output: "static"</div>
        <div class="log">website&gt; [build] Collecting build info...</div>
        <div class="log">website&gt; [build] Building static entrypoints...</div>
        <div class="log">website&gt; [build] {pages} page(s) built</div>
        <div class="log">website&gt; [build] Complete!</div>
        <div class="out">{outPath}</div>
        <div class="cmd"><span class="prompt">$</span> <span class="typed">tree -d -L 1 result</span></div>
        <div class="out">result</div>
        <ul class="tree" aria-label="sections">
          {
            sections.map((s, i) => (
              <li>
                <span class="dim">{i === sections.length - 1 ? "└──" : "├──"}</span>
                <a href={`/${s}/`}>{s}</a>
              </li>
            ))
          }
        </ul>
        <div class="out">&nbsp;</div>
        <div class="out">{sections.length} directories</div>
        <div class="cmd"><span class="prompt">$</span> <span class="cursor"></span></div>
      </div>
    </figure>
  </div>
</Layout>

<script>
  const root = document.documentElement;
  const nix = document.getElementById("nix")!;

  // colorScheme: switch the whole site and remember the choice
  const opt = nix.querySelector<HTMLButtonElement>('[data-opt="colorScheme"]')!;
  const show = () => (opt.textContent = `"${root.dataset.theme}"`);
  show();
  opt.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    localStorage.setItem("colorScheme", next);
    show();
  });

  // the build: plays once per session, again on click; the finished state is
  // in the html for no-js and reduced motion
  const term = document.getElementById("term")!;
  const steps = [...term.querySelector(".screen")!.children] as HTMLElement[];
  const texts = steps.map((s) => s.querySelector(".typed")?.textContent ?? "");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let running = false;

  async function play() {
    if (running) return;
    running = true;
    let skip = false;
    const stop = (e: Event) => {
      if (!(e.target as HTMLElement).closest("#term")) skip = true;
    };
    addEventListener("keydown", stop);
    addEventListener("pointerdown", stop);
    const wait = (ms: number) => new Promise((r) => setTimeout(r, skip ? 0 : ms));
    steps.forEach((s) => (s.hidden = true));
    await wait(600);
    for (const [i, s] of steps.entries()) {
      s.hidden = false;
      const typed = s.querySelector<HTMLElement>(".typed");
      if (typed) {
        typed.textContent = "";
        for (const ch of texts[i]!) {
          typed.textContent += ch;
          await wait(55 + Math.random() * 45);
        }
        await wait(500);
      } else if (s.classList.contains("log")) {
        await wait(260 + Math.random() * 260);
      } else {
        await wait(s.classList.contains("out") && i < 10 ? 700 : 140);
      }
    }
    removeEventListener("keydown", stop);
    removeEventListener("pointerdown", stop);
    running = false;
  }
  if (!reduced && !sessionStorage.getItem("built")) {
    sessionStorage.setItem("built", "1");
    play();
  }
  term.addEventListener("click", (e) => {
    if (!reduced && !(e.target as HTMLElement).closest("a")) play();
  });
</script>

<style is:global>
  /* global: the expression's html is built as a string, which scoped styles
     cannot reach; every selector stays under .home */
  .home {
    max-width: 50rem;
    margin: 0 auto;
    padding-top: 2.5rem;
    display: grid;
    gap: 1.75rem;
    font: 0.95rem/1.85 var(--mono);
    color: var(--muted);
  }

  /* a file and a terminal: lighter frames with a title strip */
  .home .frame {
    margin: 0;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }
  .home .frame figcaption {
    padding: 0.35rem 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--dim);
    font-size: 0.8rem;
  }
  .home .file .tab {
    color: var(--text);
  }
  .home pre.nix {
    margin: 0;
    padding: 1rem 1.25rem 1.1rem 0;
    background: none !important;
    border: 0;
    border-radius: 0;
    overflow-x: auto;
    font: inherit;
  }
  .home .ln {
    display: inline-block;
    width: 3rem;
    padding-right: 1.25rem;
    text-align: right;
    color: var(--dim);
    opacity: 0.6;
    user-select: none;
  }
  .home .c {
    color: var(--dim);
  }
  .home .k {
    color: var(--strong);
  }
  .home .s,
  .home .opt {
    color: var(--string);
  }
  .home .p {
    color: var(--dim);
  }
  .home a.s {
    text-decoration: none;
    border-bottom: 1px dashed color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .home a.s:hover {
    color: var(--accent-bright);
    border-bottom-style: solid;
  }
  .home .opt {
    font: inherit;
    background: none;
    border: 0;
    border-bottom: 1px dashed var(--string);
    padding: 0;
    cursor: pointer;
  }
  .home .opt:hover {
    color: var(--accent-bright);
  }

  /* hover info, like a language server in an editor */
  .home .hover {
    position: relative;
    cursor: help;
    border-bottom: 1px dotted var(--dim);
  }
  .home .tip {
    display: none;
    position: absolute;
    left: 0;
    top: 1.9em;
    z-index: 5;
    width: max-content;
    max-width: 24rem;
    padding: 0.5rem 0.75rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--text);
    white-space: normal;
    cursor: default;
  }
  .home .tip .t {
    color: var(--accent);
  }
  .home .tip .d {
    display: block;
    margin-top: 0.25rem;
    color: var(--muted);
  }
  .home .hover:is(:hover, :focus-visible) .tip {
    display: block;
  }

  /* the terminal; its height is fixed so the page doesn't grow while typing */
  .home .term {
    cursor: pointer;
  }
  .home .term .screen {
    padding: 1rem 1.25rem 1.1rem;
    min-height: calc(18 * 1.85em + 2.1rem);
  }
  .home .prompt {
    color: var(--accent);
  }
  .home .cmd {
    color: var(--strong);
  }
  .home .log {
    color: var(--dim);
  }
  .home .out {
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .home .tree {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .home .tree li + li {
    margin: 0;
  }
  .home .tree a {
    color: #5a8ee5;
    text-decoration: none;
    padding: 0 0.15rem;
    border-radius: 3px;
  }
  .home .tree a:is(:hover, :focus-visible) {
    background: var(--accent);
    color: var(--bg);
    outline: none;
  }
  .home .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    vertical-align: -0.2em;
    background: var(--accent);
    opacity: 0.55;
  }
</style>
