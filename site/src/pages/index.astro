---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { published } from "../lib/posts";
import { pageNames } from "../lib/search";
import {
  describeType,
  linkFor,
  tokenize,
  typeOf,
  type SettingName,
} from "../lib/fosskar";
import { fosskar } from "../lib/site-data";

// the page shows the file the site's data is evaluated from
const source = readFileSync(resolve(process.cwd(), "../fosskar.nix"), "utf8").trimEnd();
const lines = tokenize(source);

const posts = published(await getCollection("blog"));
const notes = (await getCollection("wiki")).sort(
  (a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0),
);
const day = (d?: Date) => d?.toISOString().slice(0, 10) ?? "";
const pages = pageNames({ posts, notes });
const sitePaths = new Set(Object.values(pages));

// hover text per attribute path
const hovers: Record<string, string> = {
  name: "the person behind fosskar.",
  role: "devops engineer and sre since 2023, in a team of four.",
  location: "hamburg, germany.",
  likes:
    "what i spend my free time on. local llms means llama.cpp and vllm in my homelab, with regular benchmarks.",
  me: "who i am and what i work on, my cv in english and german (page and pdf), and my code. double-click a path to edit it.",
  writing: `blog: ${posts.length} post${posts.length === 1 ? "" : "s"}, newest ${day(posts[0]?.data.date)}. wiki: ${notes.length} notes, newest ${day(notes[0]?.data.date)}. double-click a path to edit it.`,
  contact: "mail or matrix, whichever you prefer.",
  "website.settings": "how this site looks. click a value to switch it. changes stay in this browser.",
  "website.settings.colorScheme": "the colour scheme of every page.",
  "website.settings.font": "the font of the text on the other pages.",
  "website.settings.fontSize": "the base size in px; everything scales with it. click to type a number, or step with ↑/↓.",
};
const setting = (path: string) =>
  path.startsWith("website.settings.")
    ? (path.slice("website.settings.".length) as SettingName)
    : undefined;
const valueAt = (path: string) =>
  path.split(".").reduce<unknown>((o, k) => (o as Record<string, unknown>)?.[k], fosskar);
const typeAt = (path: string) => {
  const name = setting(path);
  return name ? describeType(name) : typeOf(valueAt(path));
};

const esc = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);

// the typing animation gives each line a share of 2s by its length
const typingMs = 2000;
const total = lines.reduce((n, l) => n + l.reduce((m, t) => m + t.text.length, 0), 0);
let typed = 0;
const typingStyle = (n: number) => {
  const style = `--d: ${Math.round((typed / total) * typingMs)}ms; --t: ${Math.round((n / total) * typingMs)}ms; --n: ${n}`;
  typed += n;
  return style;
};

// built as a string: a template inside <pre> would leak its own indentation
const html = lines
  .map((tokens) => {
    let length = tokens.reduce((n, t) => n + t.text.length, 0);
    let editable: string | undefined;
    // what a click on this line's value does, shown on hover at the line end
    let hint: string | undefined;
    const code = tokens
      .map((t) => {
        const text = esc(t.text);
        if (t.kind === "comment") {
          if (t.text !== "# fosskar.nix") return `<span class="c">${text}</span>`;
          // the revert button sits in this line, so showing it moves nothing
          return `<span class="c">${text}<span class="modified" hidden> (modified) <button class="restore" id="restore" type="button" title="revert to fosskar.nix" aria-label="revert to fosskar.nix"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 6.5A5 5 0 1 1 3 9.5" /><path d="M3.5 2.5v4h4" /></svg></button></span></span>`;
        }
        if (t.kind === "attr") {
          const h = t.path ? hovers[t.path] : undefined;
          if (!h) return `<span class="k">${text}</span>`;
          return `<span class="k hover" tabindex="0">${text}<span class="tip" role="tooltip"><span class="t">${t.path}</span> : ${esc(typeAt(t.path!))}<span class="d">${esc(h)}</span></span></span>`;
        }
        const name = t.path && setting(t.path);
        if (name && (t.kind === "string" || t.kind === "number")) {
          editable = t.path;
          const attrs = `data-setting="${name}" data-key="${t.path}" aria-label="${t.path}"`;
          if (t.kind === "number") {
            hint = "click and type a number";
            return `<span class="set"><span class="v" contenteditable="plaintext-only" spellcheck="false" role="textbox" ${attrs}>${text}</span></span>`;
          }
          hint = "";
          return `<span class="set">"<button class="v" type="button" ${attrs}>${esc(t.text.slice(1, -1))}</button>"</span>`;
        }
        if (t.kind === "string") {
          const value = t.text.slice(1, -1);
          const href = linkFor(value);
          if (href && sitePaths.has(href)) {
            editable = t.path;
            hint = `open ${value}`;
            return `<a class="path" href="${esc(href)}" data-editable>"<span class="v" spellcheck="false" data-key="${t.path}" data-orig="${esc(value)}">${esc(value)}</span>"</a>`;
          }
          if (href) {
            length += 1;
            hint = `opens ${href.startsWith("mailto:") ? "your mail app" : new URL(href).host}`;
            return `<a class="ext" href="${esc(href)}">${text}<span class="arrow" aria-hidden="true">↗</span></a>`;
          }
          return `<span class="s">${text}</span>`;
        }
        if (t.kind === "number") return `<span class="s">${text}</span>`;
        if (t.kind === "punct") return `<span class="p">${text}</span>`;
        return text;
      })
      .join("");
    let line = length ? `<span class="line" style="${typingStyle(length)}">${code}</span>` : code;
    if (hint !== undefined)
      line += `<span class="hint" aria-hidden="true"${editable ? ` data-hint="${editable}"` : ""}>  # ${esc(hint)}</span>`;
    if (!editable) return line + "\n";
    // the error for a value shows under its line, indented like the line; it
    // follows the line break, which would otherwise leave a blank line after it
    const indent = tokens[0]?.kind === "text" ? tokens[0].text.length : 0;
    return `${line}\n<span class="err" data-err="${editable}" style="padding-left: ${indent}ch" role="alert" hidden></span>`;
  })
  .join("")
  .trimEnd();
---

<Layout
  title={`${fosskar.name} · fosskar`}
  description={`${fosskar.name} (fosskar): ${fosskar.role} in ${fosskar.location}. nix, nixos, kubernetes and gitops.`}
  wide
>
  <div class="home">
    <script is:inline>
      // types the file once per session; set before the first paint
      if (
        !sessionStorage.getItem("typed") &&
        !matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        sessionStorage.setItem("typed", "1");
        document.currentScript.parentElement.classList.add("typing");
      }
    </script>
    <pre
      class="nix"
      id="nix"
      data-defaults={JSON.stringify(fosskar.website.settings)}
      data-pages={JSON.stringify(pages)}><code set:html={html} /></pre>
  </div>
</Layout>

<script>
  import {
    checkSetting,
    didYouMean,
    linkFor,
    settingTypes,
    suggest,
    type SettingName,
    type Settings,
  } from "../lib/fosskar";

  declare global {
    interface Window {
      applySettings(s: Settings): void;
    }
  }

  const nix = document.getElementById("nix")!;

  // a click or key press skips the typing
  const home = nix.parentElement!;
  const done = () => home.classList.remove("typing");
  addEventListener("pointerdown", done, { once: true });
  addEventListener("keydown", done, { once: true });
  const restore = document.getElementById("restore")!;
  const modified = nix.querySelector<HTMLElement>(".modified")!;
  const defaults: Settings = JSON.parse(nix.dataset.defaults!);
  const pages: Record<string, string> = JSON.parse(nix.dataset.pages!);
  let current: Settings = {
    ...defaults,
    ...JSON.parse(localStorage.getItem("settings") ?? "{}"),
  };

  function showError(key: string, message?: (string | Node)[]) {
    const el = nix.querySelector<HTMLElement>(`[data-err="${key}"]`)!;
    el.hidden = !message;
    const red = Object.assign(document.createElement("span"), {
      className: "red",
      textContent: "error:",
    });
    el.replaceChildren(...(message ? [red, " ", ...message] : []));
  }

  // only values that differ from fosskar.nix are stored
  function save() {
    const changed = Object.fromEntries(
      Object.entries(current).filter(([k, v]) => v !== defaults[k as SettingName]),
    );
    const dirty = Object.keys(changed).length > 0;
    modified.hidden = !dirty;
    if (dirty) localStorage.setItem("settings", JSON.stringify(changed));
    else localStorage.removeItem("settings");
    window.applySettings(current);
  }

  function selectAll(el: HTMLElement) {
    const range = document.createRange();
    range.selectNodeContents(el);
    getSelection()!.removeAllRanges();
    getSelection()!.addRange(range);
  }

  // website.settings: a click steps through the allowed strings; the number
  // is typed, or stepped with the arrow keys
  const settings = [...nix.querySelectorAll<HTMLElement>("[data-setting]")];
  const resets: (() => void)[] = [];
  for (const el of settings) {
    const name = el.dataset.setting as SettingName;
    const type = settingTypes[name];
    el.textContent = String(current[name]);
    if ("enum" in type) {
      const values: readonly string[] = type.enum;
      const next = () => values[(values.indexOf(String(current[name])) + 1) % values.length]!;
      const hint = el.closest(".line")!.nextElementSibling as HTMLElement;
      const show = () => {
        el.textContent = String(current[name]);
        hint.textContent = `  # click: ${current[name]} → ${next()}`;
      };
      show();
      el.addEventListener("click", () => {
        current = { ...current, [name]: next() };
        show();
        save();
      });
      resets.push(show);
      continue;
    }
    const commit = () => {
      const raw = el.textContent!.trim();
      const value = /^-?\d+$/.test(raw) ? Number(raw) : raw;
      const error = checkSetting(name, value);
      showError(el.dataset.key!, error ? [error] : undefined);
      if (error) return;
      current = { ...current, [name]: value };
      save();
    };
    el.addEventListener("focus", () => selectAll(el));
    el.addEventListener("blur", commit);
    el.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        el.blur();
      } else if (e.key === "Escape") {
        el.textContent = String(current[name]);
        showError(el.dataset.key!);
        el.blur();
      } else if (e.key === "ArrowUp" || e.key === "ArrowDown") {
        e.preventDefault();
        const step = e.key === "ArrowUp" ? 1 : -1;
        el.textContent = String(
          Math.min(type.max, Math.max(type.min, Number(current[name]) + step)),
        );
        commit();
        selectAll(el);
      }
    });
  }
  save();

  // site paths: a click follows the link, a double-click edits it; an
  // unknown path gets the same error as the 404 page
  const paths = [...nix.querySelectorAll<HTMLAnchorElement>("a[data-editable]")];
  for (const a of paths) {
    const v = a.querySelector<HTMLElement>(".v")!;
    let follow: ReturnType<typeof setTimeout> | undefined;
    let before = "";
    a.addEventListener("click", (e) => {
      if (v.isContentEditable) return e.preventDefault();
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      if (e.detail === 1) follow = setTimeout(() => (location.href = a.href), 250);
    });
    a.addEventListener("dblclick", (e) => {
      e.preventDefault();
      clearTimeout(follow);
      before = v.textContent!;
      v.contentEditable = "plaintext-only";
      v.focus();
      selectAll(v);
    });
    v.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        v.blur();
      } else if (e.key === "Escape") {
        v.textContent = before;
        v.blur();
      }
    });
    v.addEventListener("blur", () => {
      v.contentEditable = "false";
      const value = v.textContent!.trim();
      const href = linkFor(value) ?? value;
      a.setAttribute("href", href);
      if (Object.values(pages).includes(href)) return showError(v.dataset.key!);
      const name = value.split("/").filter(Boolean).at(-1) ?? value;
      const k = Object.assign(document.createElement("span"), {
        className: "k",
        textContent: name,
      });
      const hits = suggest(name, Object.keys(pages));
      showError(v.dataset.key!, [
        "attribute '",
        k,
        "' missing",
        ...(hits.length ? ["\n\n", ...didYouMean(hits, pages)] : []),
      ]);
    });
  }

  restore.addEventListener("click", () => {
    current = { ...defaults };
    for (const el of settings) el.textContent = String(current[el.dataset.setting as SettingName]);
    for (const show of resets) show();
    for (const a of paths) {
      const v = a.querySelector<HTMLElement>(".v")!;
      v.textContent = v.dataset.orig!;
      a.setAttribute("href", linkFor(v.dataset.orig!)!);
    }
    for (const el of nix.querySelectorAll<HTMLElement>("[data-err]")) showError(el.dataset.err!);
    save();
  });
</script>

<style is:global>
  /* global: the expression's html is built as a string, which scoped styles
     cannot reach; every selector stays under .home */
  /* centered horizontally; top-aligned, so errors and the revert button
     appearing below a line never move what's above it */
  main:has(> .home) {
    display: flex;
    justify-content: center;
    padding-top: 4rem;
  }
  .home {
    min-width: 0;
    max-width: 100%;
    font: 0.95rem/1.85 var(--mono);
    color: var(--muted);
  }

  .home pre.nix {
    margin: 0;
    padding: 0 0 1rem;
    background: none !important;
    border: 0;
    border-radius: 0;
    font: inherit;
  }
  /* sideways scrolling only where lines don't fit; it would clip the tooltips */
  @media (max-width: 48rem) {
    .home pre.nix {
      overflow-x: auto;
    }
  }
  /* each line is uncovered one character at a time; fill-mode backwards
     hides it until its turn and drops the clip afterwards, which would
     cut off the tooltips */
  .home.typing .line {
    animation: type var(--t) steps(var(--n), end) var(--d) backwards;
  }
  @keyframes type {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0);
    }
  }
  .home .c {
    color: var(--dim);
  }
  .home .k {
    color: var(--strong);
  }
  .home .s {
    color: var(--string);
  }
  .home .p {
    color: var(--dim);
  }
  /* the kind of value decides its colour; no underlines */
  .home .path {
    color: var(--path);
  }
  .home .ext {
    color: var(--ext);
  }
  .home .set {
    color: var(--set);
  }
  .home :is(.path, .ext) {
    text-decoration: none;
    border-radius: 3px;
  }
  .home .arrow {
    font-size: 0.8em;
    margin-left: 0.1em;
  }
  /* a button is an inline block: with the code's line-height it would be as
     tall as the whole line */
  .home button.v {
    font: inherit;
    line-height: normal;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    border-radius: 3px;
    cursor: pointer;
  }
  .home .v[contenteditable="plaintext-only"] {
    outline: none;
    border-radius: 3px;
    cursor: text;
  }
  .home :is(.path, .ext, button.v, .v[contenteditable]):is(:hover, :focus-visible),
  .home .v:focus {
    background: color-mix(in srgb, currentColor 16%, transparent);
  }
  /* what a click does, as a comment at the line end; invisible text still
     counts for the block width, so showing it moves nothing */
  .home .hint {
    color: var(--dim);
    opacity: 0;
    transition: opacity 0.12s;
  }
  .home .line:is(:hover, :focus-within) + .hint {
    opacity: 1;
  }
  /* wraps inside the file's width instead of widening the centered block */
  .home .err {
    display: block;
    contain: inline-size;
    white-space: pre-wrap;
    color: var(--text);
  }
  .home .red {
    color: #e65b53;
  }
  .home .err a {
    color: var(--accent);
  }
  .home .modified {
    color: var(--accent);
  }
  .home .restore {
    display: inline-flex;
    vertical-align: -0.35em;
    margin: -0.3em 0;
    padding: 0.3em;
    border-radius: 4px;
    background: none;
    border: 0;
    color: var(--dim);
    cursor: pointer;
  }
  .home .restore svg {
    width: 1.4em;
    height: 1.4em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .home .restore:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  /* hover info, like a language server in an editor */
  .home .hover {
    position: relative;
    cursor: help;
  }
  .home .tip {
    display: none;
    position: absolute;
    left: 0;
    bottom: 1.9em;
    z-index: 5;
    width: max-content;
    max-width: 24rem;
    padding: 0.5rem 0.75rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--text);
    white-space: normal;
    cursor: default;
  }
  .home .tip .t {
    color: var(--accent);
  }
  .home .tip .d {
    display: block;
    margin-top: 0.25rem;
    color: var(--muted);
  }
  .home .hover:is(:hover, :focus-visible) .tip {
    display: block;
  }

</style>
