---
// entry card for post listings
interface Props {
  href: string;
  title: string;
  description?: string;
  date?: Date;
}
const { href, title, description, date } = Astro.props;
---

<a class="card entry" href={href}>
  <span class="entry-title">{title}</span>
  {description && <span class="entry-desc">{description}</span>}
  {
    date && (
      <span class="meta">
        <time datetime={date.toISOString().slice(0, 10)}>
          {date.toISOString().slice(0, 10)}
        </time>
      </span>
    )
  }
</a>

<style>
  .entry {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .entry-title {
    font-weight: 600;
    color: var(--text);
  }
  .entry:hover .entry-title {
    color: var(--accent);
  }
  .entry-desc {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .entry .meta {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
</style>
